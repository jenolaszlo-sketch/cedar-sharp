<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageId>CedarSharp</PackageId>
    <Version>1.0.0</Version>
    <Title>CedarSharp</Title>
    <Description>Unofficial .NET wrapper around the Cedar policy engine, preserving authorization diagnostics and validation results. Trim- and NativeAOT-compatible.</Description>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/cedar-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/cedar-sharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cedar;authorization;policy;access-control;native;aot;trimming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <!-- Packaging stays opt-in: pass -p:CedarSharpEnablePack=true. Without it the project is not packable by design. -->
    <IsPackable Condition="'$(CedarSharpEnablePack)' != 'true'">false</IsPackable>
    <IsPackable Condition="'$(CedarSharpEnablePack)' == 'true'">true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../native/staging/**/*" Exclude="../../native/staging/**/licenses/**/*;../../native/staging/**/THIRD_PARTY_NOTICES.md;../../native/staging/**/licenses.json"
          Pack="true" PackagePath="runtimes/"
          Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../native/staging/**/*" Exclude="../../native/staging/**/*.dll;../../native/staging/**/*.so;../../native/staging/**/*.dylib;../../native/staging/**/cedarsharp-native.json"
          Pack="true" PackagePath="third-party/" />
  </ItemGroup>
  <Target Name="RequireNativeAssetsForPack" BeforeTargets="GenerateNuspec" Condition="'$(CedarSharpEnablePack)' == 'true' And '$(CedarSharpLocalSmokePack)' != 'true'">
    <Error Condition="!Exists('../../native/staging/win-x64/native/cedarsharp-native.json') Or !Exists('../../native/staging/linux-x64/native/cedarsharp-native.json') Or !Exists('../../native/staging/osx-arm64/native/cedarsharp-native.json')"
           Text="All three native RID manifests must be staged before packing. Run the native CI and package verification gates." />
  </Target>
</Project>
